<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:BragaEventos.Models" x:Class="BragaEventos.Views.AgendaPage" Title="Minha agenda" BackgroundColor="#0D1425">
<CollectionView x:Name="Eventos" SelectionMode="None">
<CollectionView.Header><VerticalStackLayout Padding="22" Spacing="10"><Label Text="MINHA AGENDA" TextColor="#61E6C1" FontAttributes="Bold" FontSize="14"/><Label Text="Eventos salvos no celular" TextColor="White" FontSize="27" FontAttributes="Bold"/><Label Text="Toque em um evento para visualizar seu resumo." TextColor="#A7BCD3"/></VerticalStackLayout></CollectionView.Header>
<CollectionView.EmptyView><Label Text="Nenhum evento salvo. Cadastre um evento e toque em Salvar na página de resumo." TextColor="White" Margin="24" FontSize="16"/></CollectionView.EmptyView>
<CollectionView.ItemTemplate><DataTemplate x:DataType="models:Evento">
<Border BackgroundColor="#1B2740" Stroke="#30435F" StrokeShape="RoundRectangle 20" Margin="16,8" Padding="16">
<VerticalStackLayout Spacing="9"><Label Text="{Binding Nome}" FontSize="20" FontAttributes="Bold" TextColor="White"/><Label Text="{Binding Inicio,StringFormat='Início: {0:dd/MM/yyyy}'}" TextColor="#61E6C1"/><Label Text="{Binding Local}" TextColor="#B5C8DA"/><Label Text="{Binding CustoTotal,StringFormat='Custo do evento: {0:C2}'}" TextColor="White"/><HorizontalStackLayout Spacing="10"><Button Text="VER RESUMO" Clicked="VerResumo" CommandParameter="{Binding .}" BackgroundColor="#61E6C1" TextColor="#102238"/><Button Text="EXCLUIR" Clicked="Excluir" CommandParameter="{Binding .}" BackgroundColor="#913F4C" TextColor="White"/></HorizontalStackLayout></VerticalStackLayout>
</Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
</ContentPage>