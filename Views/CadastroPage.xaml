<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BragaEventos.Views.CadastroPage" BackgroundColor="#0D1425" Title="Braga Eventos">
 <ScrollView><VerticalStackLayout Padding="22,20,22,34" Spacing="16">
  <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="22,24" BackgroundColor="#1D3151"><Border.Shadow><Shadow Brush="#050A16" Offset="0,9" Radius="18" Opacity="0.6"/></Border.Shadow><VerticalStackLayout Spacing="8"><Label Text="✦  BRAGA EVENTOS" TextColor="#61E6C1" FontSize="13" FontAttributes="Bold" CharacterSpacing="2"/><Label Text="Seu próximo evento começa aqui." TextColor="White" FontSize="29" FontAttributes="Bold"/><Label Text="Planeje com estilo, organize com precisão." TextColor="#CAD8EA" FontSize="14"/><Label Text="AGENDA 15  •  EXPERIÊNCIA INTELIGENTE" TextColor="#9CB8D5" FontSize="10"/></VerticalStackLayout></Border>
  <Label Text="01  Identidade do evento" TextColor="#61E6C1" FontSize="15" FontAttributes="Bold"/>
  <Border Stroke="#30435F" StrokeShape="RoundRectangle 22" BackgroundColor="#1B2740" Padding="18"><VerticalStackLayout Spacing="10"><Label Text="Nome do evento" TextColor="White"/><Entry x:Name="NomeEntry" Text="{Binding Nome,Mode=TwoWay}" Placeholder="Ex.: Encontro de Tecnologia" PlaceholderColor="#8CA2BE" TextColor="White" BackgroundColor="#253651"/><Label Text="Categoria" TextColor="White"/><Picker x:Name="CategoriaPicker" SelectedIndex="0" Title="Selecione" TextColor="White" BackgroundColor="#253651" SelectedIndexChanged="CategoriaMudou"><Picker.Items><x:String>Corporativo</x:String><x:String>Conferência</x:String><x:String>Workshop</x:String><x:String>Acadêmico</x:String><x:String>Social</x:String><x:String>Esportivo</x:String><x:String>Cultural</x:String></Picker.Items></Picker><Label Text="Local do evento" TextColor="White"/><Entry Text="{Binding Local,Mode=TwoWay}" Placeholder="Ex.: Centro de Eventos Piracicaba" PlaceholderColor="#8CA2BE" TextColor="White" BackgroundColor="#253651"/></VerticalStackLayout></Border>
  <Label Text="02  Datas e participantes" TextColor="#61E6C1" FontSize="15" FontAttributes="Bold"/>
  <Border Stroke="#30435F" StrokeShape="RoundRectangle 22" BackgroundColor="#1B2740" Padding="18"><VerticalStackLayout Spacing="10"><Label Text="Data de início" TextColor="White"/><DatePicker x:Name="InicioPicker" Date="{Binding Inicio,Mode=TwoWay}" TextColor="White" BackgroundColor="#253651" DateSelected="DatasMudaram"/><Label Text="Data de término" TextColor="White"/><DatePicker x:Name="TerminoPicker" Date="{Binding Termino,Mode=TwoWay}" TextColor="White" BackgroundColor="#253651" DateSelected="DatasMudaram"/><Label Text="Atalhos para agendamento" TextColor="White"/>
<HorizontalStackLayout Spacing="6">
<Button Text="+7 dias" Clicked="MaisSeteDias" BackgroundColor="#334967" TextColor="White" FontSize="12"/>
<Button Text="+1 mês" Clicked="MaisUmMes" BackgroundColor="#334967" TextColor="White" FontSize="12"/>
<Button Text="+1 ano" Clicked="MaisUmAno" BackgroundColor="#334967" TextColor="White" FontSize="12"/>
</HorizontalStackLayout><Label Text="Participantes" TextColor="White"/><HorizontalStackLayout Spacing="14"><Button Text="−" Clicked="Menos" BackgroundColor="#334967" TextColor="White" WidthRequest="55"/><Label Text="{Binding Participantes}" TextColor="White" FontSize="23" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="55" HorizontalTextAlignment="Center"/><Button Text="+" Clicked="Mais" BackgroundColor="#334967" TextColor="White" WidthRequest="55"/></HorizontalStackLayout><Label Text="{Binding DuracaoTexto}" TextColor="#61E6C1" FontSize="13"/></VerticalStackLayout></Border>
  <Label Text="03  Investimento" TextColor="#61E6C1" FontSize="15" FontAttributes="Bold"/>
  <Border Stroke="#30435F" StrokeShape="RoundRectangle 22" BackgroundColor="#1B2740" Padding="18"><VerticalStackLayout Spacing="10"><Label Text="Custo por participante (R$)" TextColor="White"/><Entry x:Name="CustoEntry" Text="75" Keyboard="Numeric" TextColor="White" BackgroundColor="#253651" TextChanged="CustoMudou"/><Label Text="TOTAL ESTIMADO" TextColor="#9FB5CE" FontSize="11" CharacterSpacing="2"/><Label Text="{Binding CustoTotalTexto}" TextColor="#61E6C1" FontSize="32" FontAttributes="Bold"/></VerticalStackLayout></Border>
  <Label Text="04  Hospedagem opcional" TextColor="#61E6C1" FontSize="15" FontAttributes="Bold"/>
  <Border Stroke="#30435F" StrokeShape="RoundRectangle 22" BackgroundColor="#1B2740" Padding="18">
  <VerticalStackLayout Spacing="10">
   <HorizontalStackLayout Spacing="10"><Switch IsToggled="{Binding PrecisaHospedagem,Mode=TwoWay}" OnColor="#61E6C1"/><Label Text="Participantes precisam de hospedagem" TextColor="White" VerticalOptions="Center"/></HorizontalStackLayout>
   <VerticalStackLayout IsVisible="{Binding PrecisaHospedagem}" Spacing="9">
    <Label Text="Quantidade de hóspedes" TextColor="White"/>
    <Stepper Minimum="1" Maximum="100000" Increment="1" Value="{Binding Hospedes,Mode=TwoWay}"/>
    <Label Text="{Binding Hospedes,StringFormat='Hóspedes: {0:F0}'}" TextColor="#61E6C1"/>
    <Label Text="Entrada" TextColor="White"/><DatePicker Date="{Binding EntradaHotel,Mode=TwoWay}" TextColor="White"/>
    <Label Text="Saída" TextColor="White"/><DatePicker Date="{Binding SaidaHotel,Mode=TwoWay}" TextColor="White"/>
    <Label Text="Diária estimada por hóspede (R$)" TextColor="White"/>
    <Entry x:Name="DiariaEntry" Keyboard="Numeric" Placeholder="Ex.: 180" PlaceholderColor="#8CA2BE" TextColor="White" TextChanged="DiariaMudou"/>
    <Label Text="{Binding CustoHospedagem,StringFormat='Hospedagem estimada: {0:C2}'}" TextColor="#61E6C1"/>
   </VerticalStackLayout>
  </VerticalStackLayout></Border>
  <Label Text="05  Lembretes e agenda" TextColor="#61E6C1" FontSize="15" FontAttributes="Bold"/>
  <Border Stroke="#30435F" StrokeShape="RoundRectangle 22" BackgroundColor="#1B2740" Padding="18">
   <VerticalStackLayout Spacing="10">
    <HorizontalStackLayout Spacing="10"><Switch IsToggled="{Binding Lembrete,Mode=TwoWay}" OnColor="#61E6C1"/><Label Text="Marcar evento para lembrete" TextColor="White" VerticalOptions="Center"/></HorizontalStackLayout>
    <Label Text="Preferência registrada no evento. Alertas automáticos do Android ainda não estão ativados." TextColor="#9CB5CF" FontSize="11"/>
    <Button Text="VER AGENDA DE EVENTOS" Clicked="AbrirAgenda" BackgroundColor="#334967" TextColor="White"/>
   </VerticalStackLayout>
  </Border>
  <Button x:Name="SalvarButton" Text="GERAR RESUMO DO EVENTO  →" Clicked="GerarResumo" BackgroundColor="#61E6C1" TextColor="#102238" FontAttributes="Bold" CornerRadius="17" HeightRequest="60"/>
  <Label Text="Dados calculados em tempo real com BindingContext, DateTime e TimeSpan." TextColor="#8FA6C0" FontSize="11" HorizontalTextAlignment="Center"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>