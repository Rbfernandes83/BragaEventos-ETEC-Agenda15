<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BragaEventos.Views.CadastroPage" BackgroundColor="{AppThemeBinding Light=#F2F6FB, Dark=#0D1425}" Title="Braga Eventos">
<ContentPage.ToolbarItems><ToolbarItem Text="☀ / ☾" Clicked="AlternarTema"/></ContentPage.ToolbarItems>
 <ScrollView><VerticalStackLayout Padding="22,20,22,34" Spacing="16">
  <Border x:Name="HeroCard" StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="22,24" BackgroundColor="{AppThemeBinding Light=#DCEAF5, Dark=#1D3151}"><Border.Shadow><Shadow Brush="#050A16" Offset="0,9" Radius="18" Opacity="0.6"/></Border.Shadow><VerticalStackLayout Spacing="8"><Label Text="✦  BRAGA EVENTOS" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="13" FontAttributes="Bold" CharacterSpacing="2"/><Label Text="Seu próximo evento começa aqui." TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="29" FontAttributes="Bold"/><Label Text="Planeje com estilo, organize com precisão." TextColor="{AppThemeBinding Light=#334B63, Dark=#CAD8EA}" FontSize="14"/><Label Text="AGENDA 15  •  EXPERIÊNCIA INTELIGENTE" TextColor="{AppThemeBinding Light=#4B647D, Dark=#9CB8D5}" FontSize="10"/></VerticalStackLayout></Border>
  <Label Text="01  Identidade do evento" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="15" FontAttributes="Bold"/>
  <Border x:Name="IdentidadeCard" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Padding="18"><VerticalStackLayout Spacing="10"><Label Text="Nome do evento" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><Entry x:Name="NomeEntry" Text="{Binding Nome,Mode=TwoWay}" Placeholder="Ex.: Encontro de Tecnologia" PlaceholderColor="{AppThemeBinding Light=#63788D, Dark=#8CA2BE}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" BackgroundColor="{AppThemeBinding Light=#E7EFF7, Dark=#253651}"/><Label Text="Categoria" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><Picker x:Name="CategoriaPicker" TitleColor="{AppThemeBinding Light=#52677D, Dark=#FFFFFF}" SelectedIndex="0" Title="Selecione" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" BackgroundColor="{AppThemeBinding Light=#E7EFF7, Dark=#253651}" SelectedIndexChanged="CategoriaMudou"><Picker.Items><x:String>Corporativo</x:String><x:String>Conferência</x:String><x:String>Workshop</x:String><x:String>Acadêmico</x:String><x:String>Social</x:String><x:String>Esportivo</x:String><x:String>Cultural</x:String></Picker.Items></Picker><Label Text="Local do evento" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><Entry Text="{Binding Local,Mode=TwoWay}" Placeholder="Ex.: Centro de Eventos Piracicaba" PlaceholderColor="{AppThemeBinding Light=#63788D, Dark=#8CA2BE}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" BackgroundColor="{AppThemeBinding Light=#E7EFF7, Dark=#253651}"/></VerticalStackLayout></Border>
  <Button Text="📷  ESCOLHER IMAGEM DO EVENTO" Clicked="EscolherImagem" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
  <Image Source="{Binding ImagemPath}" IsVisible="{Binding TemImagem}" HeightRequest="150" Aspect="AspectFill"/>
  <Label Text="02  Datas e participantes" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="15" FontAttributes="Bold"/>
  <Border x:Name="DatasCard" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Padding="18"><VerticalStackLayout Spacing="10"><Label Text="Data de início" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><DatePicker x:Name="InicioPicker" Date="{Binding Inicio,Mode=TwoWay}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" BackgroundColor="{AppThemeBinding Light=#E7EFF7, Dark=#253651}" DateSelected="DatasMudaram"/><Label Text="Data de término" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><DatePicker x:Name="TerminoPicker" Date="{Binding Termino,Mode=TwoWay}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" BackgroundColor="{AppThemeBinding Light=#E7EFF7, Dark=#253651}" DateSelected="DatasMudaram"/><Label Text="Atalhos para agendamento" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
<HorizontalStackLayout Spacing="6">
<Button Text="+7 dias" Clicked="MaisSeteDias" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="12"/>
<Button Text="+1 mês" Clicked="MaisUmMes" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="12"/>
<Button Text="+1 ano" Clicked="MaisUmAno" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="12"/>
</HorizontalStackLayout><Label Text="Participantes" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><HorizontalStackLayout Spacing="14"><Button Text="−" Clicked="Menos" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" WidthRequest="55"/><Label Text="{Binding Participantes}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="23" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="55" HorizontalTextAlignment="Center"/><Button Text="+" Clicked="Mais" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" WidthRequest="55"/></HorizontalStackLayout><Label Text="{Binding DuracaoTexto}" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="13"/></VerticalStackLayout></Border>
  <Label Text="03  Investimento" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="15" FontAttributes="Bold"/>
  <Border x:Name="InvestimentoCard" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Padding="18"><VerticalStackLayout Spacing="10"><Label Text="Custo por participante (R$)" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><Entry x:Name="CustoEntry" Text="75" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" BackgroundColor="{AppThemeBinding Light=#E7EFF7, Dark=#253651}" TextChanged="CustoMudou"/><Label Text="TOTAL ESTIMADO" TextColor="{AppThemeBinding Light=#52677D, Dark=#9FB5CE}" FontSize="11" CharacterSpacing="2"/><Label Text="{Binding CustoTotalTexto}" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="32" FontAttributes="Bold"/></VerticalStackLayout></Border>
  <Label Text="04  Hospedagem opcional" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="15" FontAttributes="Bold"/>
  <Border x:Name="HospedagemCard" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Padding="18">
  <VerticalStackLayout Spacing="10">
   <HorizontalStackLayout Spacing="10"><Switch IsToggled="{Binding PrecisaHospedagem,Mode=TwoWay}" OnColor="#61E6C1"/><Label Text="Participantes precisam de hospedagem" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" VerticalOptions="Center"/></HorizontalStackLayout>
   <VerticalStackLayout IsVisible="{Binding PrecisaHospedagem}" Spacing="9">
    <Label Text="Quantidade de hóspedes" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
    <Stepper Minimum="1" Maximum="100000" Increment="1" Value="{Binding Hospedes,Mode=TwoWay}"/>
    <Label Text="{Binding Hospedes,StringFormat='Hóspedes: {0:F0}'}" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}"/>
    <Label Text="Entrada" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><DatePicker Date="{Binding EntradaHotel,Mode=TwoWay}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
    <Label Text="Saída" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/><DatePicker Date="{Binding SaidaHotel,Mode=TwoWay}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
    <Label Text="Diária estimada por hóspede (R$)" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
    <Entry x:Name="DiariaEntry" Keyboard="Numeric" Placeholder="Ex.: 180" PlaceholderColor="{AppThemeBinding Light=#63788D, Dark=#8CA2BE}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" TextChanged="DiariaMudou"/>
    <Label Text="{Binding CustoHospedagem,StringFormat='Hospedagem estimada: {0:C2}'}" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}"/>
   </VerticalStackLayout>
  </VerticalStackLayout></Border>
  <Label Text="05  Lembretes e agenda" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="15" FontAttributes="Bold"/>
  <Border x:Name="LembretesCard" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Padding="18">
   <VerticalStackLayout Spacing="10">
    <HorizontalStackLayout Spacing="10"><Switch IsToggled="{Binding Lembrete,Mode=TwoWay}" OnColor="#61E6C1"/><Label Text="Marcar evento para lembrete" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" VerticalOptions="Center"/></HorizontalStackLayout>
    <Label Text="Preferência registrada no evento. Alertas automáticos do Android ainda não estão ativados." TextColor="{AppThemeBinding Light=#52677D, Dark=#9CB5CF}" FontSize="11"/>
    <Button Text="VER AGENDA DE EVENTOS" Clicked="AbrirAgenda" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
   </VerticalStackLayout>
  </Border>
  <Button x:Name="SalvarButton" Text="GERAR RESUMO DO EVENTO  →" Clicked="GerarResumo" BackgroundColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#102238}" FontAttributes="Bold" CornerRadius="17" HeightRequest="60"/>
  <Label Text="Dados calculados em tempo real com BindingContext, DateTime e TimeSpan." TextColor="{AppThemeBinding Light=#52677D, Dark=#8FA6C0}" FontSize="11" HorizontalTextAlignment="Center"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>