</VerticalStackLayout></Border>
<Button Text="SALVAR NA MINHA AGENDA" Clicked="SalvarAgenda" BackgroundColor="#334967" TextColor="White" CornerRadius="16" HeightRequest="54"/>
<Button Text="← EDITAR EVENTO" Clicked="Voltar" BackgroundColor="#61E6C1" TextColor="#102238" FontAttributes="Bold" CornerRadius="16" HeightRequest="56"/></VerticalStackLayout></ScrollView></ContentPage>