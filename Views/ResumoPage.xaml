<?xml version="1.0" encoding="utf-8"?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BragaEventos.Views.ResumoPage" Title="Resumo do evento" BackgroundColor="#0D1425"><ScrollView><VerticalStackLayout Padding="22" Spacing="18"><Border BackgroundColor="#1D3151" StrokeThickness="0" StrokeShape="RoundRectangle 25" Padding="22"><VerticalStackLayout Spacing="8"><Label Text="✓  EVENTO CADASTRADO" TextColor="#61E6C1" FontAttributes="Bold" FontSize="12"/><Label Text="{Binding Nome}" TextColor="White" FontSize="28" FontAttributes="Bold"/><Label Text="{Binding Categoria}" TextColor="#C8D7E9"/><Label Text="{Binding Local}" TextColor="#C8D7E9"/></VerticalStackLayout></Border><Label Text="DETALHES DA PROGRAMAÇÃO" TextColor="#61E6C1" FontAttributes="Bold" FontSize="13"/><Border BackgroundColor="#1B2740" Stroke="#30435F" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="13"><Label Text="Início" TextColor="#9CB5CF"/><Label Text="{Binding Inicio, StringFormat='{0:dd/MM/yyyy}'}" TextColor="White" FontSize="20"/><BoxView HeightRequest="1" Color="#30435F"/><Label Text="Término" TextColor="#9CB5CF"/><Label Text="{Binding Termino, StringFormat='{0:dd/MM/yyyy}'}" TextColor="White" FontSize="20"/><BoxView HeightRequest="1" Color="#30435F"/><Label Text="{Binding DuracaoTexto}" TextColor="#61E6C1" FontAttributes="Bold"/></VerticalStackLayout></Border><Label Text="RESUMO FINANCEIRO" TextColor="#61E6C1" FontAttributes="Bold" FontSize="13"/><Border BackgroundColor="#1B2740" Stroke="#30435F" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="12"><Label Text="Participantes" TextColor="#9CB5CF"/><Label Text="{Binding Participantes}" TextColor="White" FontSize="21"/><Label Text="Custo individual" TextColor="#9CB5CF"/><Label Text="{Binding CustoPorParticipante,StringFormat='{0:C2}'}" TextColor="White" FontSize="21"/><BoxView HeightRequest="1" Color="#30435F"/><Label Text="CUSTO TOTAL" TextColor="#9CB5CF" FontSize="12"/><Label Text="{Binding CustoTotal,StringFormat='{0:C2}'}" TextColor="#61E6C1" FontSize="34" FontAttributes="Bold"/></VerticalStackLayout></Border><Border BackgroundColor="#1B2740" Stroke="#30435F" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="10">
<Label Text="HOSPEDAGEM E PLANEJAMENTO" TextColor="#61E6C1" FontAttributes="Bold"/>
<Label Text="{Binding PrecisaHospedagem,StringFormat='Hospedagem solicitada: {0}'}" TextColor="White"/>
<Label Text="{Binding DiasHospedagem,StringFormat='Noites previstas: {0}'}" TextColor="White"/>
<Label Text="{Binding CustoHospedagem,StringFormat='Hospedagem estimada: {0:C2}'}" TextColor="White"/>
<Label Text="{Binding CustoGeral,StringFormat='TOTAL GERAL ESTIMADO: {0:C2}'}" TextColor="#61E6C1" FontSize="21" FontAttributes="Bold"/>
