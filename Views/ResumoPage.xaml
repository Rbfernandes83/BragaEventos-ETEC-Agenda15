<?xml version="1.0" encoding="utf-8"?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BragaEventos.Views.ResumoPage" Title="Resumo do evento" BackgroundColor="{AppThemeBinding Light=#F2F6FB, Dark=#0D1425}">
<ContentPage.ToolbarItems><ToolbarItem Text="☀ / ☾" Clicked="AlternarTema"/></ContentPage.ToolbarItems><ScrollView><VerticalStackLayout Padding="22" Spacing="18"><Border BackgroundColor="{AppThemeBinding Light=#DCEAF5, Dark=#1D3151}" StrokeThickness="0" StrokeShape="RoundRectangle 25" Padding="22"><VerticalStackLayout Spacing="8"><Label Text="✓  RESUMO DO EVENTO" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontAttributes="Bold" FontSize="12"/><Label Text="{Binding Nome}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="28" FontAttributes="Bold"/><Label Text="{Binding Categoria}" TextColor="{AppThemeBinding Light=#334B63, Dark=#C8D7E9}"/><Label Text="{Binding Local}" TextColor="{AppThemeBinding Light=#334B63, Dark=#C8D7E9}"/></VerticalStackLayout></Border><Image Source="{Binding ImagemPath}" IsVisible="{Binding TemImagem}" HeightRequest="180" Aspect="AspectFill"/><Label Text="DETALHES DA PROGRAMAÇÃO" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontAttributes="Bold" FontSize="13"/><Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="13"><Label Text="Início" TextColor="{AppThemeBinding Light=#52677D, Dark=#9CB5CF}"/><Label Text="{Binding Inicio, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="20"/><BoxView HeightRequest="1" Color="#30435F"/><Label Text="Término" TextColor="{AppThemeBinding Light=#52677D, Dark=#9CB5CF}"/><Label Text="{Binding Termino, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="20"/><BoxView HeightRequest="1" Color="#30435F"/><Label Text="{Binding DuracaoTexto}" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontAttributes="Bold"/></VerticalStackLayout></Border><Label Text="RESUMO FINANCEIRO" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontAttributes="Bold" FontSize="13"/><Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="12"><Label Text="Participantes" TextColor="{AppThemeBinding Light=#52677D, Dark=#9CB5CF}"/><Label Text="{Binding Participantes}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="21"/><Label Text="Custo individual" TextColor="{AppThemeBinding Light=#52677D, Dark=#9CB5CF}"/><Label Text="{Binding CustoPorParticipante,StringFormat='{0:C2}'}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" FontSize="21"/><BoxView HeightRequest="1" Color="#30435F"/><Label Text="CUSTO TOTAL" TextColor="{AppThemeBinding Light=#52677D, Dark=#9CB5CF}" FontSize="12"/><Label Text="{Binding CustoTotal,StringFormat='{0:C2}'}" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="34" FontAttributes="Bold"/></VerticalStackLayout></Border><Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2740}" Stroke="{AppThemeBinding Light=#C9D9E8, Dark=#30435F}" StrokeShape="RoundRectangle 22" Padding="20"><VerticalStackLayout Spacing="10">
<Label Text="HOSPEDAGEM E PLANEJAMENTO" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontAttributes="Bold"/>
<Label Text="{Binding HospedagemStatus,StringFormat='Hospedagem solicitada: {0}'}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
<Label IsVisible="{Binding ExibirHospedagem}" Text="{Binding DiasHospedagem,StringFormat='Noites previstas: {0}'}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
<Label IsVisible="{Binding ExibirHospedagem}" Text="{Binding CustoHospedagem,StringFormat='Hospedagem estimada: {0:C2}'}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
<Label Text="{Binding CustoGeral,StringFormat='TOTAL GERAL ESTIMADO: {0:C2}'}" TextColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" FontSize="21" FontAttributes="Bold"/>
<Label Text="{Binding LembreteStatus,StringFormat='Preferência de lembrete: {0}'}" TextColor="{AppThemeBinding Light=#52677D, Dark=#A7BCD3}"/>
</VerticalStackLayout></Border>
<Button Text="COMPARTILHAR EVENTO" Clicked="Compartilhar" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
<Button Text="ABRIR LOCAL NO MAPA" Clicked="AbrirMapa" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
<Button Text="EXPORTAR RESUMO EM PDF" Clicked="ExportarPdf" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}"/>
<Button Text="SALVAR NA MINHA AGENDA" Clicked="SalvarAgenda" BackgroundColor="{AppThemeBinding Light=#D6E4F1, Dark=#334967}" TextColor="{AppThemeBinding Light=#172A42, Dark=White}" CornerRadius="16" HeightRequest="54"/>
<Button Text="← EDITAR EVENTO" Clicked="Voltar" BackgroundColor="{AppThemeBinding Light=#087F70, Dark=#61E6C1}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#102238}" FontAttributes="Bold" CornerRadius="16" HeightRequest="56"/></VerticalStackLayout></ScrollView></ContentPage>